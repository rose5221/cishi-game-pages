    {
      "id": "preamble",
      "header": "World Overview",
      "content": "# 此世 · 借名夜\n\n<!-- rag: always priority: 10 triggers: 此世, 闻忆城, 借名夜, 三证, 改笔, 自由行动 -->",
      "tokens": 59,
      "alwaysInclude": true,
